# ==============================================================================
# One Time Product BD — Environment Configuration
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
# .env.local is ignored by Git and will not be committed.

# ------------------------------------------------------------------------------
# Firebase Client Configuration (Web App)
# Find these in Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# Cloudinary Configuration (Media Storage)
# Find these in Cloudinary Dashboard -> Product Environment Settings -> API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Unsigned upload preset if you want direct client unsigned uploads
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=otpb_unsigned_preset

